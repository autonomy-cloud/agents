# Server API Configuration
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

# Teams-meeting join bridge (optional — see api/teams-join.ts and
# runtime/components/openagents-teams-bridge/ABSORBED.md). Only needed if
# you started the bridge with ENABLE_TEAMS_BRIDGE=1 in scripts/dev-up.sh —
# copy TEAMS_BRIDGE_API_TOKEN out of the repo root's generated
# .env.teams-bridge into here too, since this is a separate process.
TEAMS_BRIDGE_URL=http://127.0.0.1:7000
TEAMS_BRIDGE_API_TOKEN=

# Public configuration
NEXT_PUBLIC_LIVEKIT_URL=wss://YOUR_LIVEKIT_URL

# Application Configuration
NEXT_PUBLIC_APP_CONFIG="
title: 'Coworker Console'
description: 'A workbench for testing and operating digital coworker agents.'
video_fit: 'contain' # 'contain' or 'cover'
settings:
  editable: true # Should the user be able to edit settings in-app
  theme_color: 'cyan'
  chat: true  # Enable or disable chat feature
  known_agents: # Static list of deployed agent names offered as dropdown suggestions
                # for explicit dispatch. This is NOT live-discovered (there is no
                # server API to enumerate registered agent workers) — keep it in
                # sync by hand as you deploy/rename agents.
    - name: 'anika-coworker'
  outputs:
    audio: true # Enable or disable audio output
    video: true # Enable or disable video output
  inputs:
    mic: true    # Enable or disable microphone input
    camera: true # Enable or disable camera input
    sip: true    # Enable or disable SIP input
"
